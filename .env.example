# Active Director: ollama | anthropic | openai | static
LLM_DIRECTOR_PROVIDER=ollama
LLM_DIRECTOR_TIMEOUT_MS=15000

# Optional one-line RunConfiguration JSON used when provider=static
LLM_DIRECTOR_STATIC_CONFIG=

OLLAMA_API_KEY=
OLLAMA_DIRECTOR_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=https://ollama.com

ANTHROPIC_API_KEY=
ANTHROPIC_DIRECTOR_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_DIRECTOR_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=https://api.openai.com/v1

VITE_WORKER_HOST=127.0.0.1:8787
VITE_ROOM_CONNECT_TIMEOUT_MS=10000
VITE_DIRECTOR_TIMEOUT_MS=18000
